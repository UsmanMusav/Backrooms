# OPTIONAL server-side LLM. Normal play already uses the bundled small neural networks.
# No credentials are included. Never use VITE_* for secrets.
# Source production server only: copy to .env, then AFTER npm run build:
#   node --env-file=.env server/cli.mjs
# The Windows EXE does NOT read this file; set its process environment instead.
# See docs/MIMIC-AI.md. Ollama/model weights must be installed separately.
MIMIC_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
MIMIC_LLM_MODEL=qwen2.5:3b
MIMIC_LLM_KEY=
MIMIC_LLM_TIMEOUT_MS=5000
MIMIC_LLM_RPM=12
# Keep remote data sharing OFF unless the server operator deliberately enables it.
MIMIC_ALLOW_REMOTE_AI=0
